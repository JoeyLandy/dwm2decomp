; Hardware symbols (Pan Docs / hardware.inc names). Generated by tools/disasm_all.py.

DEF rP1 EQU $FF00 ; joypad: write bit 4 or 5 low to select the d-pad or the buttons, read bits 0-3 (0 = pressed)
DEF rSB EQU $FF01 ; serial transfer data byte
DEF rSC EQU $FF02 ; serial control: bit 7 starts a transfer, bit 0 picks the internal clock (CGB bit 1: fast clock)
DEF rDIV EQU $FF04 ; divider: counts up at 16384 Hz; any write resets it
DEF rTIMA EQU $FF05 ; timer counter: counts at the rTAC rate and requests the timer interrupt when it overflows
DEF rTMA EQU $FF06 ; timer modulo: loaded into rTIMA when it overflows
DEF rTAC EQU $FF07 ; timer control: bit 2 enables the timer, bits 0-1 pick 4096/262144/65536/16384 Hz
DEF rIF EQU $FF0F ; interrupt flags: bit 0 VBlank, 1 LCD STAT, 2 timer, 3 serial, 4 joypad requested
DEF rNR10 EQU $FF10 ; sound channel 1 sweep: time, direction and shift
DEF rNR11 EQU $FF11 ; sound channel 1 duty (bits 6-7) and length
DEF rNR12 EQU $FF12 ; sound channel 1 volume envelope: initial volume, direction, period
DEF rNR13 EQU $FF13 ; sound channel 1 frequency, low 8 bits
DEF rNR14 EQU $FF14 ; sound channel 1 frequency high 3 bits, length enable (bit 6) and trigger (bit 7)
DEF rNR21 EQU $FF16 ; sound channel 2 duty (bits 6-7) and length
DEF rNR22 EQU $FF17 ; sound channel 2 volume envelope
DEF rNR23 EQU $FF18 ; sound channel 2 frequency, low 8 bits
DEF rNR24 EQU $FF19 ; sound channel 2 frequency high 3 bits, length enable and trigger
DEF rNR30 EQU $FF1A ; sound channel 3 (wave) on/off: bit 7
DEF rNR31 EQU $FF1B ; sound channel 3 length
DEF rNR32 EQU $FF1C ; sound channel 3 output level: bits 5-6 (mute, 100%, 50%, 25%)
DEF rNR33 EQU $FF1D ; sound channel 3 frequency, low 8 bits
DEF rNR34 EQU $FF1E ; sound channel 3 frequency high 3 bits, length enable and trigger
DEF rNR41 EQU $FF20 ; sound channel 4 (noise) length
DEF rNR42 EQU $FF21 ; sound channel 4 volume envelope
DEF rNR43 EQU $FF22 ; sound channel 4 polynomial counter: clock shift, width, divisor
DEF rNR44 EQU $FF23 ; sound channel 4 length enable and trigger
DEF rNR50 EQU $FF24 ; master volume: left (bits 4-6) and right (bits 0-2)
DEF rNR51 EQU $FF25 ; sound panning: which channels go to the left (bits 4-7) and right (bits 0-3) outputs
DEF rNR52 EQU $FF26 ; sound on/off (bit 7, write) and channel status (bits 0-3, read)
DEF rLCDC EQU $FF40 ; LCD control: bit 7 LCD on, 6 window map, 5 window on, 4 BG/window tiles, 3 BG map, 2 sprite size, 1 sprites on, 0 BG on (CGB: BG priority)
DEF rSTAT EQU $FF41 ; LCD status: mode (bits 0-1), LY = LYC (bit 2) and the STAT interrupt sources (bits 3-6)
DEF rSCY EQU $FF42 ; background scroll Y
DEF rSCX EQU $FF43 ; background scroll X
DEF rLY EQU $FF44 ; the line being drawn, 0-153 (144-153 is VBlank)
DEF rLYC EQU $FF45 ; line compare: rSTAT bit 2 and the STAT interrupt fire when rLY equals it
DEF rDMA EQU $FF46 ; OAM DMA: writing $XX copies $XX00-$XX9F to OAM (run from HRAM)
DEF rBGP EQU $FF47 ; DMG background palette: two bits per shade
DEF rOBP0 EQU $FF48 ; DMG sprite palette 0
DEF rOBP1 EQU $FF49 ; DMG sprite palette 1
DEF rWY EQU $FF4A ; window Y position
DEF rWX EQU $FF4B ; window X position + 7
DEF rKEY1 EQU $FF4D ; CGB speed switch: bit 0 arms a switch done by stop, bit 7 is the current speed
DEF rVBK EQU $FF4F ; CGB VRAM bank: bit 0 (bank 1 holds the BG attributes)
DEF rHDMA1 EQU $FF51 ; CGB VRAM DMA source, high byte
DEF rHDMA2 EQU $FF52 ; CGB VRAM DMA source, low byte (low 4 bits ignored)
DEF rHDMA3 EQU $FF53 ; CGB VRAM DMA destination, high byte (in VRAM)
DEF rHDMA4 EQU $FF54 ; CGB VRAM DMA destination, low byte
DEF rHDMA5 EQU $FF55 ; CGB VRAM DMA start: length / $10 - 1 in bits 0-6; bit 7 picks HBlank DMA
DEF rRP EQU $FF56 ; CGB infrared port
DEF rBGPI EQU $FF68 ; CGB background palette index: bits 0-5 the byte, bit 7 auto-increment
DEF rBGPD EQU $FF69 ; CGB background palette data at rBGPI
DEF rOBPI EQU $FF6A ; CGB sprite palette index
DEF rOBPD EQU $FF6B ; CGB sprite palette data at rOBPI
DEF rSVBK EQU $FF70 ; CGB WRAM bank at $D000-$DFFF: bits 0-2 (0 selects 1)
DEF rIE EQU $FFFF ; interrupt enable: the same bits as rIF
DEF rWAVE EQU $FF30 ; 16 bytes of wave pattern RAM

DEF rRAMG EQU $0100 ; MBC5 RAM enable: write $0A to enable cartridge RAM, anything else to disable
