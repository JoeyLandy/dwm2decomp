; Offsets into the $A5-byte SRAM monster record that have evidence (config/record_fields.json, E-0290).
DEF MON_STATE EQU $00 ; state: 0 empty, 1 or 2 in use (E-0104)
DEF MON_NAME EQU $01 ; name, 10 bytes ending in $F0 (E-0034)
DEF MON_SPECIES EQU $0B ; word compared with monster ids by talk events $29/$47 (C1: the species id) (E-0236)
DEF MON_FAMILY EQU $0D ; low nibble = family (E-0122)
DEF MON_SEX EQU $0E ; bit 0 = sex (C1): after the first parent is chosen, breeding steps back when no other listed record has a different bit 0; the record list draws mark tile $CC + bit 0 when byte $6E is 2 (E-0291)
DEF MON_MASTER_NAME EQU $0F ; the master's name, 10 bytes: ComputeBreedingChild stores the player name here (CopyPlayerNameToWCADF) and copies each parent's into the child's parent master names (E-0297); called 'second name' in E-0034 (E-0034, E-0297)
DEF MON_PARENT1_SPECIES EQU $1A ; species word of the first parent (from its $0B; CopySixBytesByWCADDBit4Table, the order swapped by bit 4 of $0D) (E-0297)
DEF MON_PARENT2_SPECIES EQU $1C ; species word of the second parent (E-0297)
DEF MON_PARENT1_MASTER EQU $1E ; master name of the first parent (from its $0F; CopyFourNamesByWCADDBit4Table) (E-0297)
DEF MON_PARENT2_MASTER EQU $29 ; master name of the second parent (E-0297)
DEF MON_SKILLS EQU $34 ; skills, 8 bytes (E-0122)
DEF MON_SKILL_LIST EQU $3C ; the list AppendMappedSkillsToWCA67 appends to, up to $FF (E-0237)
DEF MON_STATUS EQU $55 ; status bits (bit 2 read as poison) (E-0085)
DEF MON_LEVEL EQU $56 ; level (E-0122)
DEF MON_MAX_LEVEL EQU $57 ; level cap (C1): DrawRecordLevelAndStatusRow_1E loads $56-$57 as a pair and draws the cap mark $6F when the level is at least this byte (E-0296)
DEF MON_EXP EQU $58 ; experience, 24 bits (E-0125)
DEF MON_HP EQU $5B ; HP word (E-0122)
DEF MON_MAX_HP EQU $5D ; maximum HP word (E-0122)
DEF MON_MP EQU $5F ; MP word (E-0122)
DEF MON_MAX_MP EQU $61 ; maximum MP word (E-0122)
DEF MON_ATK EQU $63 ; ATK word (C1: first of the stats column, raised by AddAToRecordWordCapped like $65-$69) (E-0290)
DEF MON_DEF EQU $65 ; DEF word (C1) (E-0290)
DEF MON_AGL EQU $67 ; AGL word (C1) (E-0290)
DEF MON_INT EQU $69 ; INT word (C1) (E-0290)
DEF MON_WLD EQU $6B ; WLD (wildness) word (C1): the fifth word of the stats column after ATK, DEF, AGL and INT, matching the INFO panel's order ATK, DEF, AGL, INT, WLD (E-0046); drawn by the same stat path (E-0296)
DEF MON_PLUS EQU $6D ; the breeding plus value (C1): when non-zero, the monster's info screen (WithSRAMDraw4ACEAnd4BE8_ShowStringBank08AtTilesHL_Bank03) draws glyph $FC and the value in one or two digits after the member number; BreedMenu_CopyToChildThenTalkEvent16 copies it to the child record (E-0296)
DEF MON_EGG EQU $6E ; non-zero marks an egg (C1): when CountRecordsByField6E counts none the battle-end flow shows 'You have no eggs.', the egg lists (ListRecordsInUseWithByte6ESet, 'Switch which egg?') take records with it set, CreateMonsterRecordOfKindTemp1 sets it to 1 for kinds 1 and 2, and DrawRecordListPageMarks shows the sex mark only when it is 2 (E-0296)
DEF MON_PERSONALITY EQU $6F ; four personality axes, $6F-$72, from MonsterTable bytes 22-25 (E-0034)
DEF MON_PARENT1_NAME EQU $8E ; name of the first parent (from its $01; CopyFourNamesByWCADDBit4Table) (E-0297)
DEF MON_PARENT1_PLUS EQU $98 ; plus value of the first parent (from its $6D) (E-0297)
DEF MON_PARENT2_NAME EQU $99 ; name of the second parent (E-0297)
DEF MON_PARENT2_PLUS EQU $A3 ; plus value of the second parent (E-0297)
DEF MON_ITEM EQU $A4 ; equipped item (E-0125)

; Offsets into the $4E-byte battler record (wBattlerRecords; config/record_fields.json "battler", E-0298).
DEF BATTLER_NAME EQU $00 ; name, 10 bytes ($FF-filled by LoadMonsterAndSpeciesForListEntryC_ReadRecordBufferAndRecordBufferData for a wild monster) (E-0298)
DEF BATTLER_SPECIES EQU $0A ; species word (MonsterTable bytes 0-1, also wSpeciesIdLo/Hi) (E-0298)
DEF BATTLER_SKILLS EQU $0E ; four skills (MonsterTable bytes 2-5) (E-0298)
DEF BATTLER_LEVEL EQU $17 ; level (MonsterTable byte 9 for a wild monster) (E-0298)
DEF BATTLER_EXP EQU $18 ; experience, 24 bits (MonsterTable bytes 6-7 and a zero high byte for a wild monster) (E-0298)
DEF BATTLER_HP EQU $1B ; HP word (MonsterTable base HP) (E-0298)
DEF BATTLER_MAX_HP EQU $1D ; maximum HP word (GetBaseHP) (E-0062, E-0298)
DEF BATTLER_MP EQU $1F ; MP word (E-0298)
DEF BATTLER_MAX_MP EQU $21 ; maximum MP word (GetBaseMP) (E-0124, E-0298)
DEF BATTLER_ATK EQU $23 ; ATK word (GetBaseATK) (E-0124)
DEF BATTLER_DEF EQU $25 ; DEF word (GetBaseDEF) (E-0124)
DEF BATTLER_AGL EQU $27 ; AGL word (GetBaseAGL) (E-0124)
DEF BATTLER_INT EQU $29 ; INT word (GetBaseINT) (E-0124)
DEF BATTLER_PERSONALITY EQU $2D ; personality bytes (MonsterTable bytes 22, 23, 25, 24 in that order) (E-0298)
